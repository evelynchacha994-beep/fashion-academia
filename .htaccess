# Forzar a Apache a buscar index.html dentro de la carpeta frontend
DirectoryIndex frontend/index.html

# Habilitar reescritura de URLs para el backend
RewriteEngine On

# Si la petición es para /backend/, dejar que PHP la maneje
RewriteCond %{REQUEST_URI} ^/backend/ [NC]
RewriteRule ^ - [L]

# Redirigir cualquier otra ruta al frontend/index.html (para SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /frontend/index.html [L,QSA]